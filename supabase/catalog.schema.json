{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "seedVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "categories": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "recipes": {
      "maxItems": 3000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,80}$"
          },
          "menuNumber": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceTitle": {
            "type": "string",
            "maxLength": 300
          },
          "englishName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "burmeseName": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "categoryId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "line": {
            "type": "string",
            "enum": [
              "barista",
              "cold"
            ]
          },
          "image": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "cupSizes": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 8
                },
                {
                  "type": "number",
                  "const": 12
                },
                {
                  "type": "number",
                  "const": 16
                },
                {
                  "type": "number",
                  "const": 22
                }
              ]
            }
          },
          "ingredients": {
            "minItems": 1,
            "maxItems": 80,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000
                },
                "quantity": {
                  "type": "string",
                  "maxLength": 3000
                }
              },
              "required": [
                "name",
                "quantity"
              ],
              "additionalProperties": false
            }
          },
          "sourceIngredients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "quantity"
              ],
              "additionalProperties": false
            }
          },
          "steps": {
            "minItems": 1,
            "maxItems": 80,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3000
            }
          },
          "notes": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3000
            }
          },
          "espressoDose": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "espressoYield": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "iceQuantity": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "milkQuantity": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "waterQuantity": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "sweetnessLevel": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "verification": {
            "type": "string",
            "enum": [
              "source-unverified",
              "owner-tested"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "maxLength": 300
              },
              "sha256": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "file",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "menuNumber",
          "sourceTitle",
          "englishName",
          "burmeseName",
          "categoryId",
          "line",
          "image",
          "cupSizes",
          "ingredients",
          "steps",
          "notes",
          "espressoDose",
          "espressoYield",
          "iceQuantity",
          "milkQuantity",
          "waterQuantity",
          "sweetnessLevel",
          "version",
          "updatedAt",
          "verification"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "categories",
    "recipes"
  ],
  "additionalProperties": false
}